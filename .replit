modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
CERTIFICATE_ADMIN_EMAIL = "policyp28@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-708009a1-e56d-48c6-8c7f-479bfd5daf43"
